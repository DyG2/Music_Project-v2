# Copie ce fichier en ".env" et renseigne tes valeurs Supabase.
# (Supabase Dashboard > Project Settings > API)
#
# La cle "anon" est publique : cote Vite, les variables VITE_* sont
# incluses dans le build front. C'est normal et sans risque, la securite
# etant assuree par les regles RLS (voir supabase/schema.sql).

VITE_SUPABASE_URL=https://ton-projet.supabase.co
VITE_SUPABASE_ANON_KEY=ta_cle_anon_publique
